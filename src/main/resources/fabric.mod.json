{
  "schemaVersion": 1,
  "id": "novaclient",
  "version": "${version}",
  "name": "NovaClient",
  "description": "A futuristic Minecraft client-side mod with ESP, Freecam, and modern GUI",
  "authors": ["Vo1cikk"],
  "contact": {},
  "license": "MIT",
  "icon": "assets/novaclient/icon.png",
  "environment": "client",
  "entrypoints": {
    "main": [
      "com.novaclient.NovaClientMod"
    ]
  },
  "mixins": [
    "novaclient.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=${loader_version}",
    "minecraft": "${minecraft_version}"
  }
}
